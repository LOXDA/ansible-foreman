localhost ansible_connection=local

[tfm:vars]
ansible_connection=ssh 
ansible_user=debian 
opn_autoip=false
opn_project=lab01
opn_network=lab01
opn_sg=ALLOW_ALL

[tfm:children]
tfm_app
tfm_db
tfm_proxy
tfm_puppet

[tfm_app]
tfm-app.lab01.opn.lab opn_flavor=m1.large

[tfm_db]
tfm-db.lab01.opn.lab opn_flavor=m1.small

[tfm_proxy]
tfm-proxy.lab01.opn.lab opn_flavor=m1.medium

[tfm_proxy_salt]
tfm-proxy-salt.lab01.opn.lab opn_flavor=m1.medium

[tfm_puppet]
tfm-puppet.lab01.opn.lab opn_flavor=m1.medium

[tfm_proxy:children]
tfm_proxy_salt

[monitoring:vars]
ansible_connection=ssh 
ansible_user=debian 
opn_autoip=false
opn_project=lab01
opn_network=lab01
opn_sg=ALLOW_ALL

[monitoring:children]
monitoring_db
monitoring_web
monitoring_app
monitoring_sat

[monitoring_db]
mon-db.lab01.opn.lab opn_flavor=m1.medium opn_image=Debian-12

[monitoring_web]
mon-web.lab01.opn.lab opn_flavor=m1.medium opn_image=Debian-12

[monitoring_app]
mon-app.lab01.opn.lab opn_flavor=m1.medium opn_image=Debian-12

[monitoring_sat]
mon-sat.lab01.opn.lab opn_flavor=m1.medium opn_image=Debian-12
